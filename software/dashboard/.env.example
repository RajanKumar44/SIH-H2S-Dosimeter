# ── H2S Dosimeter — Dashboard (Vite) configuration ─────────────────────
# Copy this file to `.env` (same directory) and adjust as needed.
# Only variables prefixed with VITE_ are exposed to the frontend bundle.

# Base URL of the FastAPI backend. Defaults to http://localhost:8000 if unset.
VITE_API_BASE=http://localhost:8000
