# ── H2S Dosimeter — Backend configuration ──────────────────────────────
# Copy this file to `.env` (same directory) and adjust values.
# The backend reads these via config.py. NEVER commit a real .env.

# Environment: "development" (default) or "production".
# In production the app REFUSES to start unless SECRET_KEY is set below.
APP_ENV=development

# JWT signing secret. REQUIRED in production.
# Generate a strong one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# JWT algorithm (default HS256) and access-token lifetime in minutes (default 480 = 8h).
JWT_ALGORITHM=HS256
TOKEN_EXPIRE_MINUTES=480

# Database URL.
#   Dev  (default): sqlite:///./h2s_dosimeter.db
#   Prod (example): postgresql+psycopg2://user:password@localhost:5432/h2s_dosimeter
DATABASE_URL=sqlite:///./h2s_dosimeter.db

# Comma-separated list of allowed CORS origins (browser/web clients).
# Leave UNSET to use the built-in default, which already covers:
#   * dashboard dev server   http://localhost:5173  / http://127.0.0.1:5173
#   * mobile PWA dev server  http://localhost:5174  / http://127.0.0.1:5174
#   * deployed dashboard     https://sih-h2s-dosimeter.vercel.app
# Setting this variable REPLACES that default list, so include every web
# origin you need. Never use "*" — credentials are enabled.
# CORS_ORIGINS=https://sih-h2s-dosimeter.vercel.app

# Capacitor / Cordova native WebView origins.
# The Android app does not run on an http://<ip>:<port> origin — inside the
# native WebView the Origin header is one of:
#     https://localhost   http://localhost
#     capacitor://localhost   ionic://localhost
# These four are ALWAYS appended to the allow-list (even in production, and
# even when CORS_ORIGINS is overridden above) so the phone app can reach the
# API. Without them the app fails with "Cannot reach the server" even though
# /health opens fine in the phone's browser.
# Set to "false" ONLY if you are deploying a web-only backend.
ALLOW_NATIVE_APP_ORIGINS=true

# Optional regex for additional origins. In development a private-LAN /
# dev-tunnel regex is applied automatically; in production the regex is
# DISABLED unless you set this explicitly.
# CORS_ORIGIN_REGEX=
